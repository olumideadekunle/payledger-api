# Application
PROJECT_NAME="PayLedger API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"   # set to "production" on Vercel
DEBUG=False

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON list of allowed browser origins, e.g. ["https://app.example.com"]
CORS_ORIGINS=["*"]

# Database
# Local default: async SQLite. In production use Postgres; provider URLs such as
# postgres://user:pass@host/db?sslmode=require are converted to asyncpg automatically.
# On Vercel, POSTGRES_URL (injected by the Neon integration) is used if DATABASE_URL is unset.
DATABASE_URL="sqlite+aiosqlite:///./payledger.db"

# Financial Limits & Rules
MAX_DAILY_TRANSFER_LIMIT=500000.00
DEFAULT_CURRENCY="NGN"
ALLOWED_CURRENCIES=["NGN", "USD", "EUR", "GBP"]
