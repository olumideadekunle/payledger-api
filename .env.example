# Application
PROJECT_NAME="PayLedger API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: Async SQLite; For Postgres: postgresql+asyncpg://user:pass@localhost:5432/payledger)
DATABASE_URL="sqlite+aiosqlite:///./payledger.db"

# Financial Limits & Rules
MAX_DAILY_TRANSFER_LIMIT=500000.00
DEFAULT_CURRENCY="NGN"
ALLOWED_CURRENCIES=["NGN", "USD", "EUR", "GBP"]
